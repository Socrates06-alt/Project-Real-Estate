ENV=dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nilayam

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

STORAGE_BACKEND=local          # local | supabase
LOCAL_MEDIA_DIR=./media
PRIVATE_BUCKET=submissions
PUBLIC_BUCKET=listings

CORS_ORIGINS=["http://localhost:5173"]
TRUST_PROXY_HEADERS=false      # true in production behind Cloudflare/Nginx
TURNSTILE_SECRET=              # empty disables captcha
IP_HASH_SALT=change-me

CONTACT_PHONE=+910000000000
CONTACT_WHATSAPP=+910000000000
CONSENT_VERSION=2026-11-v1
MATERIAL_PRICE_CHANGE_PCT=5

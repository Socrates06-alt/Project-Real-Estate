# LandFinder web server: free automatic HTTPS (Let's Encrypt), the app, and the API.
# setup.sh replaces example.com with your domain.

www.example.com {
	redir https://example.com{uri} permanent
}

example.com {
	encode zstd gzip

	# Photos: up to 3 x 8 MB per submission
	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	# API and published photos -> backend (only listens on this server)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /media/public/* {
		header Cache-Control "public, max-age=86400"
		reverse_proxy 127.0.0.1:8000
	}

	# The web app (built files). Unknown paths load the app, which shows the right page.
	handle {
		root * /opt/landfinder/frontend/dist
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/landfinder.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

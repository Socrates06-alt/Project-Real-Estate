# LandFinder live-server settings. setup.sh copies this to /opt/landfinder/backend/.env
# Keep this file private: it holds the admin passwords.

PRODUCTION=true

# Each founder's own admin password: at least 12 characters, not shared anywhere else.
# Tip: use 3-4 random words, e.g. mango-river-lantern-42
ADMIN_PASSWORD=
ADMIN_PASSWORD_2=

# Where the data lives (outside the code folder, so updates never touch it)
DATABASE_PATH=/var/lib/landfinder/landfinder.db
MEDIA_DIR=/var/lib/landfinder/media

# The site's address (setup.sh fills this in)
CORS_ORIGINS=["https://example.com"]

# Shown to buyers and sellers: your real numbers, with +91
CONTACT_PHONE=+91
CONTACT_WHATSAPP=+91

# Kerala RERA agent registration number (shown on listings once filled in)
RERA_NUMBER=

CONSENT_VERSION=2026-11-v1
SELLER_BROKERAGE_PCT=2
BUYER_BROKERAGE_PCT=1
MATERIAL_PRICE_CHANGE_PCT=5

# Search by meaning (small free model on this server). Raise the score if unrelated results appear.
SEMANTIC_SEARCH=true
SEMANTIC_MIN_SCORE=0.45
